---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import DepthDemo from '../components/DepthDemo.astro';
import { DEMO_MAILTO, PRICING } from '../config';

import logoColor from '../assets/logo-color.png';
import logoWhite from '../assets/logo-white.png';
import heroCages from '../assets/hero-cages.jpg';
import farmSea from '../assets/farm-sea.jpg';
import hwDeployed from '../assets/hw-deployed.jpg';
import hwPontoon from '../assets/hw-pontoon.jpg';
import hwEnclosure from '../assets/hw-enclosure.jpg';
import hwSensorMount from '../assets/hw-sensor-mount.jpg';

// The page is one story told in short chapters: one idea per screen.
// Supporting detail lives in the collapsed "more" blocks.

const nav = [
  { href: '#story', label: 'The story' },
  { href: '#how', label: 'How it works' },
  { href: '#demo', label: 'Try it' },
  { href: '#pricing', label: 'Pricing' },
];

const loop = [
  { name: 'Sense', line: 'A sensor line reads the water at several depths.', out: 'A picture of the whole water column.' },
  { name: 'Decide', line: 'Pearlora suggests a better depth. Your operator says yes or no.', out: 'An approved target depth.' },
  { name: 'Act', line: 'A winch raises or lowers the baskets, within safe limits.', out: 'Oysters in better water.' },
  { name: 'Verify', line: 'A node on the batten confirms where the baskets ended up.', out: 'Proof that it worked, kept on record.' },
];

const layers = [
  { label: 'Warm surface', note: 'heat exposure', cls: 'bg-[#f3b79b] text-[#7a2d0c]' },
  { label: 'Suitable layer', note: 'cooler, enough oxygen', cls: 'bg-mint text-abyss ring-4 ring-white' },
  { label: 'Deep water', note: 'oxygen can run low', cls: 'bg-tide text-white' },
];

const hardware = [
  { img: hwPontoon, name: 'Control pontoon and winch', body: 'A solar-powered float with a winch that moves every lift line equally, so the batten stays level.' },
  { img: hwEnclosure, name: 'Controller', body: 'Sealed electronics that decide on site and report to shore. Emergency stop and manual override included.' },
  { img: hwSensorMount, name: 'Batten and verification node', body: 'Your nets hang from an adjustable batten. A node on it reports the real depth after every move.' },
];

const software = [
  'Water quality by depth, through the day',
  'A suitability score for each depth, from your own thresholds',
  'Depth recommendations that wait for operator approval',
  'Before-and-after readings for every move',
  'Reminders for cleaning, oyster checks and calibration',
];

const science = [
  ['The water column is layered.', 'Surface water may be warmer, with cooler water below the thermocline. It varies by site and season.', 'NOAA Ocean Service'],
  ['Heat stresses Pinctada maxima.', 'Marine-heatwave experiments found physiological stress and rising mortality at severe temperatures.', 'Xu et al., 2021'],
  ['Depth and season interact.', 'A North Lombok field study linked juvenile oyster survival to both season and culture depth.', 'Hamzah & Nababan, 2011'],
];

const sources = [
  'Atlas Pearls Ltd., Annual Reports FY25 and FY26.',
  'NOAA, Ocean Acidification; NOAA Ocean Service, Thermocline and Dissolved Oxygen.',
  'Marine Environmental Research 215 (2026), 107821.',
  'Xu et al. (2021), Marine Pollution Bulletin, doi:10.1016/j.marpolbul.2021.112932.',
  'Hamzah & Nababan (2011), doi:10.29244/jitkt.v3i2.7821.',
];
---

<Base>
  <header class="sticky top-0 z-40 border-b border-ink/10 bg-white/95 backdrop-blur">
    <div class="container-x flex h-16 items-center justify-between gap-4">
      <a href="#top" class="shrink-0" aria-label="Pearlora home">
        <Image src={logoColor} alt="Pearlora" height={44} class="h-11 w-auto" loading="eager" />
      </a>
      <nav aria-label="Main" class="hidden items-center gap-7 text-sm font-semibold text-ink/80 md:flex">
        {nav.map((n) => <a href={n.href} class="hover:text-teal">{n.label}</a>)}
      </nav>
      <a href={DEMO_MAILTO} class="btn bg-deep px-5 py-2.5 text-white hover:bg-tide">Request a demo</a>
    </div>
  </header>

  <main id="main">
    <!-- Opening -->
    <section id="top" class="relative isolate flex min-h-[calc(100svh-4rem)] items-center overflow-hidden bg-abyss text-white">
      <Image
        src={heroCages}
        alt=""
        widths={[640, 1024, 1400]}
        sizes="(min-width: 1024px) 55vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-y-0 right-0 -z-10 h-full w-full object-cover opacity-40 lg:w-[58%] lg:opacity-100"
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-abyss via-abyss/90 to-abyss/10 max-lg:via-abyss/70"></div>
      <div class="container-x py-20">
        <h1 class="max-w-3xl text-5xl font-extrabold leading-[1.03] tracking-tight text-balance sm:text-7xl">
          We cannot control the ocean.
          <span class="block text-mint">But we can change how we respond.</span>
        </h1>
        <p class="aside text-white/85">Climate-adaptive depth management for pearl oyster farms.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={DEMO_MAILTO} class="btn btn-primary">Request a demo</a>
          <a href="#story" class="btn btn-ghost">Read the story ↓</a>
        </div>
      </div>
    </section>

    <!-- 1. Something is wrong -->
    <section id="story" class="chapter bg-abyss text-white">
      <div class="container-x">
        <p class="chapter-no reveal text-mint">01 · North Bali</p>
        <h2 class="statement reveal d1">Oysters started dying. Nobody could say why.</h2>
        <p class="aside reveal d2 text-white/75">
          Atlas Pearls reported mortality above historical levels at its nursery, two years in a row. It reviewed its
          own hatchery and found nothing wrong.
        </p>
      </div>
    </section>

    <!-- 2. The suspect -->
    <section class="chapter bg-deep text-white">
      <div class="container-x">
        <p class="chapter-no reveal text-mint">02 · The suspect</p>
        <blockquote class="reveal d1">
          <p class="statement font-bold">
            “Environmental conditions are the <span class="text-mint">most likely major contributor</span>.”
          </p>
          <footer class="mt-6 text-sm text-white/60">Atlas Pearls, FY26 Annual Report</footer>
        </blockquote>
        <p class="aside reveal d2 text-white/75">
          The water itself is changing. The ocean’s surface is about 30% more acidic than before industry, and marine
          heatwaves add to the stress.
        </p>
      </div>
    </section>

    <!-- 3. Depth -->
    <section class="chapter bg-tide text-white">
      <div class="container-x grid items-center gap-14 lg:grid-cols-[1.3fr_1fr]">
        <div>
          <p class="chapter-no reveal text-mint">03 · A way out</p>
          <h2 class="statement reveal d1">A few metres down, it is different water.</h2>
          <p class="aside reveal d2 text-white/80">
            Temperature and oxygen change with depth. Somewhere in the column there is often a layer that suits your
            oysters better. It moves with the weather and the season.
          </p>
          <details class="more reveal d2">
            <summary>The science behind this</summary>
            <ul class="space-y-3 px-5 pb-5 text-white/85">
              {
                science.map(([t, d, s]) => (
                  <li>
                    <strong>{t}</strong> {d} <em class="text-white/60">({s})</em>
                  </li>
                ))
              }
            </ul>
          </details>
        </div>
        <div class="reveal d1 mx-auto w-full max-w-xs" role="img" aria-label="Diagram: a warm surface layer, a suitable middle layer, and deep water where oxygen can run low">
          <div class="overflow-hidden rounded-3xl shadow-2xl">
            {
              layers.map((l) => (
                <div class={`relative px-6 py-9 ${l.cls}`}>
                  <p class="text-lg font-extrabold">{l.label}</p>
                  <p class="text-sm opacity-80">{l.note}</p>
                </div>
              ))
            }
          </div>
          <p class="mt-3 text-center text-xs italic text-white/60">Conceptual. Deeper is not automatically safer.</p>
        </div>
      </div>
    </section>

    <!-- 4. The catch -->
    <section class="chapter bg-foam">
      <div class="container-x grid items-center gap-14 lg:grid-cols-[1.3fr_1fr]">
        <div>
          <p class="chapter-no reveal text-teal">04 · The catch</p>
          <h2 class="statement reveal d1">Knowing is not enough if you cannot act in time.</h2>
          <p class="aside reveal d2 text-ink/75">
            Today the water is checked by hand, now and then. Baskets stay at one depth, and are moved manually, usually
            after conditions have already turned.
          </p>
        </div>
        <Image
          src={farmSea}
          alt="A pearl farm work raft and lines of buoys on calm water below forested hills"
          widths={[400, 720]}
          sizes="(min-width: 1024px) 380px, 100vw"
          class="reveal d1 max-h-[30rem] w-full rounded-3xl object-cover shadow-lg"
        />
      </div>
    </section>

    <!-- 5. Meet Pearlora -->
    <section id="system" class="chapter bg-white">
      <div class="container-x">
        <p class="chapter-no reveal text-teal">05 · Meet Pearlora</p>
        <h2 class="statement reveal d1">It finds the better water, and moves your oysters there.</h2>
        <p class="aside reveal d2 text-ink/75">A retrofit for the longlines you already have. Nothing is replaced.</p>
        <figure class="reveal mt-12">
          <Image
            src={hwDeployed}
            alt="Concept view of Pearlora: a solar-powered pontoon with a winch at the surface, a profile sensor in the water, and an adjustable batten carrying oyster nets"
            widths={[640, 1024, 1470]}
            sizes="(min-width: 1152px) 1104px, 100vw"
            class="w-full rounded-3xl shadow-lg"
          />
          <figcaption class="src">System concept visualization.</figcaption>
        </figure>
        <details class="more reveal">
          <summary>What is in the system</summary>
          <div class="px-5 pb-5">
            <div class="grid gap-5 sm:grid-cols-3">
              {
                hardware.map((h) => (
                  <div>
                    <Image src={h.img} alt="" widths={[360]} sizes="320px" class="h-36 w-full rounded-xl bg-[#dceef8] object-contain" />
                    <p class="mt-3 font-bold">{h.name}</p>
                    <p class="mt-1 text-ink/75">{h.body}</p>
                  </div>
                ))
              }
            </div>
            <p class="mt-6 font-bold">And a dashboard that gives you:</p>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-ink/75">
              {software.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        </details>
      </div>
    </section>

    <!-- 6. The loop: one step per screen -->
    <section id="how" class="bg-foam py-24">
      <div class="container-x">
        <p class="chapter-no reveal text-teal">06 · How it works</p>
        <h2 class="statement reveal d1">Four steps, on repeat.</h2>
        <div class="mt-6 grid gap-x-16 lg:grid-cols-[1fr_1.2fr]" data-loop>
          <ol class="sticky top-28 hidden self-start py-10 lg:block" aria-hidden="true">
            {
              loop.map((s, i) => (
                <li data-loop-label={i} class="text-6xl font-extrabold uppercase leading-tight tracking-tight text-ink/15 transition-colors duration-500 xl:text-7xl">
                  {s.name}
                </li>
              ))
            }
          </ol>
          <ol>
            {
              loop.map((s, i) => (
                <li data-loop-step={i} class="flex min-h-[34svh] flex-col justify-center lg:min-h-[62svh]">
                  <p class="text-sm font-extrabold uppercase tracking-[0.2em] text-teal">
                    0{i + 1}<span class="lg:hidden"> · {s.name}</span>
                  </p>
                  <p class="mt-3 max-w-md text-3xl font-bold leading-snug text-balance sm:text-4xl">{s.line}</p>
                  <p class="mt-5 max-w-md text-ink/70">
                    <span class="font-bold text-teal">You get:</span> {s.out}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>
        <p class="reveal mt-4 max-w-2xl text-lg font-semibold">
          Nothing moves without your operator’s approval, and every move is checked afterwards.
        </p>
      </div>
    </section>

    <!-- 7. Try it -->
    <section id="demo" class="bg-abyss py-24 text-white">
      <div class="container-x">
        <p class="chapter-no reveal text-mint">07 · Your turn</p>
        <h2 class="statement reveal d1">Change the water. Watch it respond.</h2>
        <p class="aside reveal d2 text-white/75">Drag a slider, then approve the move the way your operator would.</p>
        <div class="reveal mt-12">
          <DepthDemo />
        </div>
      </div>
    </section>

    <!-- 8. Pricing -->
    <section id="pricing" class="chapter bg-white">
      <div class="container-x">
        <p class="chapter-no reveal text-teal">08 · What it costs</p>
        <h2 class="statement reveal d1">Lease the hardware. Subscribe to the platform.</h2>
        <dl class="reveal d2 mt-14 grid gap-10 sm:grid-cols-3">
          {
            PRICING.map((p) => (
              <div class="border-l-4 border-mint pl-5">
                <dt class="text-sm font-bold uppercase tracking-widest text-teal">{p.name}</dt>
                <dd class="mt-2 text-5xl font-extrabold tracking-tight">{p.price}</dd>
                <dd class="mt-1 text-sm text-ink/60">{p.unit}</dd>
              </div>
            ))
          }
        </dl>
        <details class="more reveal">
          <summary>What each one covers</summary>
          <ul class="space-y-2 px-5 pb-5 text-ink/75">
            {
              PRICING.map((p) => (
                <li>
                  <strong class="text-ink">{p.name}:</strong> {p.detail}
                </li>
              ))
            }
          </ul>
        </details>
        <p class="src">Indicative, in Indonesian rupiah (M = million). To be validated with pilot farms.</p>
      </div>
    </section>

    <!-- 9. The ask -->
    <section id="pilot" class="chapter bg-deep text-white">
      <div class="container-x text-center">
        <p class="chapter-no reveal text-mint">09 · What happens next</p>
        <h2 class="statement reveal d1 mx-auto">
          Help us prove it on your water. <span class="text-mint">Join the pilot.</span>
        </h2>
        <p class="aside reveal d2 mx-auto text-white/80">
          Pearlora is a working prototype, not yet validated at sea. We are looking for <em>P. maxima</em> farms to
          trial it on a small area and measure the results with us.
        </p>
        <a href={DEMO_MAILTO} class="btn btn-primary reveal d2 mt-9 px-8 py-4 text-base">Request a demo</a>
      </div>
    </section>
  </main>

  <footer class="bg-abyss py-12 text-white/70">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <Image src={logoWhite} alt="Pearlora" height={64} class="h-16 w-auto" />
          <p class="mt-3 text-sm">Active climate adaptation for pearl oyster farms.</p>
        </div>
        <p class="text-xs">© {new Date().getFullYear()} Pearlora</p>
      </div>
      <details class="more mt-8 max-w-none text-xs">
        <summary>Sources and notes</summary>
        <div class="px-5 pb-5">
          <ul class="space-y-1.5 leading-relaxed">
            {sources.map((s) => <li>{s}</li>)}
          </ul>
          <p class="mt-4">
            Climate risk does not establish the cause of Atlas Pearls’ reported mortalities. Illustrations are concept
            visualizations, and the depth simulation is illustrative, not site data.
          </p>
        </div>
      </details>
    </div>
  </footer>
</Base>

<script>
  // Highlight the current step word as its text scrolls through the middle of the screen.
  document.querySelectorAll<HTMLElement>('[data-loop]').forEach((root) => {
    const labels = root.querySelectorAll<HTMLElement>('[data-loop-label]');
    const set = (i: string | undefined) =>
      labels.forEach((l) => {
        const on = l.dataset.loopLabel === i;
        l.classList.toggle('text-teal', on);
        l.classList.toggle('text-ink/15', !on);
      });
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && set((e.target as HTMLElement).dataset.loopStep)),
      { rootMargin: '-45% 0px -45% 0px' },
    );
    root.querySelectorAll('[data-loop-step]').forEach((el) => io.observe(el));
    set('0');
  });
</script>
